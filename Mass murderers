<!DOCTYPE html>
<html lang="hu">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>True Crime Denmark</title>

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <style>
        body {
            margin: 0;
            padding: 0;
            background-color: black;
            font-family: Calibri, sans-serif;
        }

        .container {
            width: 80%;
            margin: auto;
            background-color: white;
            min-height: 100vh;
            padding: 30px;
            box-sizing: border-box;
        }

        h1 {
            text-align: center;
        }

        /* SEARCH */
        .search-box {
            text-align: center;
            margin-bottom: 30px;
        }

        .search-box input {
            width: 60%;
            padding: 12px;
            border: 2px solid black;
        }

        .search-box button {
            padding: 12px 20px;
            background: black;
            color: white;
            border: none;
            cursor: pointer;
        }

        /* ICON CARDS */
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 20px;
            margin: 30px 0;
        }

        .card {
            display: block;
            text-align: center;
            padding: 20px;
            border-radius: 12px;
            background: #f4f4f4;
            text-decoration: none;
            color: black;
            transition: 0.3s;
        }

        .card i {
            font-size: 28px;
            color: darkred;
            margin-bottom: 10px;
        }

        .card:hover {
            transform: scale(1.05);
            background: #e9e9e9;
        }

        /* BLOG */
        .blog-post {
            margin-bottom: 40px;
        }

        .blog-post h2 {
            color: black;
        }

        .blog-post p {
            line-height: 1.6;
        }

        /* FOOTER MENU */
        .footer-menu {
            margin-top: 40px;
        }

    </style>
</head>

<body>

<div class="container">

    <h1>True Crime Denmark</h1>

    <!-- SEARCH -->
    <div class="search-box">
        <input type="text" id="searchInput" placeholder="Søg i blogindlæg...">
        <button onclick="searchPosts()">Søg</button>
    </div>

    <!-- KATEGÓRIA IKONOK -->
    <div class="grid">

        <a class="card" href="musik.html">
            <i class="fa-solid fa-music"></i>
            <h3>Musik</h3>
        </a>

        <a class="card" href="#manson">
            <i class="fa-solid fa-mask"></i>
            <h3>Manson Family</h3>
        </a>

        <a class="card" href="#kvinder">
            <i class="fa-solid fa-user-ninja"></i>
            <h3>Kvinder</h3>
        </a>

    </div>

    <!-- BLOG BEJEGYZÉSEK -->
    <div class="blog-post" id="manson">
        <h2>Manson Family mordene</h2>
        <p>...</p>
    </div>

    <div class="blog-post" id="kvinder">
        <h2>Kvindelige massemordere</h2>
        <p>...</p>
    </div>

    <!-- ALSÓ MENÜ IKONOKKAL -->
    <div class="grid footer-menu">

        <a class="card" href="omos.html">
            <i class="fa-solid fa-circle-info"></i>
            <h3>Om os</h3>
        </a>

        <a class="card" href="vilkar.html">
            <i class="fa-solid fa-file-contract"></i>
            <h3>Vilkår</h3>
        </a>

        <a class="card" href="disclaimer.html">
            <i class="fa-solid fa-triangle-exclamation"></i>
            <h3>Disclaimer</h3>
        </a>

        <a class="card" href="privatlivspolitik.html">
            <i class="fa-solid fa-user-shield"></i>
            <h3>Privatliv</h3>
        </a>

        <a class="card" href="kontakt.html">
            <i class="fa-solid fa-envelope"></i>
            <h3>Kontakt</h3>
        </a>

    </div>

    <div class="footer">
        © 2026 True Crime Denmark
    </div>

</div>

<script>
function searchPosts() {
    let input = document.getElementById("searchInput").value.toLowerCase();
    let posts = document.getElementsByClassName("blog-post");

    for (let i = 0; i < posts.length; i++) {
        let text = posts[i].innerText.toLowerCase();

        if (text.includes(input)) {
            posts[i].style.display = "block";
        } else {
            posts[i].style.display = "none";
        }
    }
}
</script>

</body>
</html>
